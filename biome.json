{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"scripts/**",
			"packages/*/src/**",
			"packages/*/tests/**",
			"packages/*/examples/**",
			"packages/docs/app/**",
			"packages/docs/components/**",
			"packages/docs/lib/**",
			"tests/**",
			"packages/docs/*.ts",
			"packages/docs/*.mjs",
			"packages/*/*.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
